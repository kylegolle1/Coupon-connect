# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Supabase project settings → API. Not needed yet: the app uses sample data until these are set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Example: NEXT_PUBLIC_SUPABASE_URL=https://khkjwmjtfqieniobcmoi.supabase.co
# Show the made-up demo stores (1 = show). Leave blank in production.
NEXT_PUBLIC_SHOW_DEMO=
